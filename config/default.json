{
  "db": {
    "file": "data/vertical-live.db",
    "busyTimeoutMs": 5000,
    "provisional": ["busyTimeoutMs"]
  },
  "obs": {
    "url": "ws://127.0.0.1:4455",
    "connectTimeoutMs": 5000,
    "pollIntervalMs": 2000,
    "commandVerifyTimeoutMs": 5000,
    "commandVerifyIntervalMs": 250,
    "browserSourceName": "vertical-live-renderer",
    "streamIngestUrl": "rtmps://a.rtmps.youtube.com:443/live2",
    "reconnect": {
      "initialDelayMs": 1000,
      "maxDelayMs": 30000,
      "factor": 2
    },
    "thresholds": {
      "congestionDegradedAt": 0.2,
      "skippedFrameRatioDegradedAt": 0.01,
      "stalledSamplesDegradedAt": 2
    },
    "provisional": [
      "pollIntervalMs",
      "commandVerifyTimeoutMs",
      "commandVerifyIntervalMs",
      "connectTimeoutMs",
      "reconnect",
      "thresholds"
    ]
  },
  "youtube": {
    "auth": {
      "credentialService": "vertical-live",
      "loopbackHost": "127.0.0.1",
      "loginTimeoutMs": 300000,
      "accessTokenRefreshSkewMs": 120000,
      "scopes": ["https://www.googleapis.com/auth/youtube.force-ssl"],
      "provisional": ["loginTimeoutMs", "accessTokenRefreshSkewMs"]
    },
    "quota": {
      "dailyUnits": 10000,
      "resetTimeZone": "America/Los_Angeles",
      "reserveUnits": 500,
      "backoff": {
        "initialDelayMs": 1000,
        "maxDelayMs": 300000,
        "factor": 2,
        "jitterRatio": 0.2,
        "maxAttempts": 8
      },
      "provisional": ["reserveUnits", "backoff"]
    }
  }
}
