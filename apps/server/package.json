{
  "name": "@vl/server",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./input": {
      "types": "./dist/input/index.d.ts",
      "default": "./dist/input/index.js"
    }
  },
  "scripts": {
    "build": "tsc --build && node scripts/copy-migrations.mjs && node scripts/generate-data-map.mjs --check",
    "data-map:generate": "tsc --build && node scripts/generate-data-map.mjs",
    "start": "node dist/main.js",
    "obs:probe": "tsc --build && node dist/obs/probe.js",
    "auth:login": "npm run build && node dist/bin/auth-login.js",
    "secrets": "npm run build && node dist/bin/secrets.js"
  },
  "dependencies": {
    "@grpc/grpc-js": "1.14.4",
    "@grpc/proto-loader": "0.8.1",
    "@napi-rs/keyring": "1.3.0",
    "@vl/contract": "0.0.0",
    "better-sqlite3": "13.0.3",
    "google-auth-library": "10.5.0",
    "googleapis": "174.0.1",
    "obs-websocket-js": "5.0.8",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/ws": "8.18.1"
  }
}
