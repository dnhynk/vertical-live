# Dependency lifecycle scripts are not run on install.
#
# Why this is required (not a preference): `better-sqlite3` ships its native
# binding prebuilt for every supported platform inside the npm tarball
# (`prebuilds/win32-x64.node`, `linux-x64.node`, …) and sets `"gypfile": false`
# to tell npm not to build it. npm never sees that field on a registry install —
# neither the abbreviated packument nor `package-lock.json` carries `gypfile` —
# so `@npmcli/arborist` finds the package's `binding.gyp`, injects
# `install: node-gyp rebuild`, and a clean `npm ci` tries to compile SQLite from
# source. On the primary Windows 11 host (BOARD D-2) that fails: there is no
# Windows SDK. Skipping install scripts makes the bundled prebuild the thing that
# is actually used, which is what the package intends.
#
# Verified safe for the two dependencies that do declare install scripts:
# `esbuild` gets its binary from the `@esbuild/win32-x64` optional dependency,
# and `fsevents` is macOS-only and optional. CI run 31999612915 installed with
# both scripts skipped (npm 11.7's `allowScripts` gate did this by default) and
# all five gates passed.
#
# `scripts/check-install-scripts.mjs` (part of `npm run lint`) fails the build if
# a new dependency needs an install script, or if the native binding does not
# load, so this setting cannot silently break a later task.
ignore-scripts=true
