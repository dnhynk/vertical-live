{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vl:contract:v1:ws-renderer-message",
  "title": "RendererToServerMessage",
  "description": "WebSocket messages sent by the renderer: hello, ack_state, ack_effect, renderer_health (spec §7.3(7), §9.4(4)).",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "number",
          "const": 1
        },
        "type": {
          "type": "string",
          "const": "hello"
        },
        "rendererId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,64}$"
        },
        "lastAppliedStateRevision": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "schemaVersion",
        "type",
        "rendererId",
        "lastAppliedStateRevision"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "number",
          "const": 1
        },
        "type": {
          "type": "string",
          "const": "ack_state"
        },
        "stateRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "appliedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
        }
      },
      "required": [
        "schemaVersion",
        "type",
        "stateRevision",
        "appliedAt"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "number",
          "const": 1
        },
        "type": {
          "type": "string",
          "const": "ack_effect"
        },
        "effectId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "appliedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
        }
      },
      "required": [
        "schemaVersion",
        "type",
        "effectId",
        "appliedAt"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "number",
          "const": 1
        },
        "type": {
          "type": "string",
          "const": "renderer_health"
        },
        "frameCounter": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "fps": {
          "type": "number",
          "minimum": 0
        },
        "webglContextLost": {
          "type": "boolean"
        },
        "lastAppliedStateRevision": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "lastAppliedEffectId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,128}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "schemaVersion",
        "type",
        "frameCounter",
        "fps",
        "webglContextLost",
        "lastAppliedStateRevision",
        "lastAppliedEffectId"
      ],
      "additionalProperties": false
    }
  ]
}
