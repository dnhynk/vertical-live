{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vl:contract:v1:canonical-event",
  "title": "CanonicalEvent",
  "description": "Canonical event minimum contract (spec §7.4).",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "eventKey": {
      "type": "string",
      "pattern": "^(youtube|simulator):([A-Za-z0-9_-]{1,128}):([A-Za-z0-9_-]{1,128})(?::gift:([1-9][0-9]{0,15}))?$"
    },
    "ingestSeq": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "source": {
      "type": "string",
      "enum": [
        "youtube",
        "simulator"
      ]
    },
    "broadcastId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,128}$"
    },
    "liveChatId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,128}$"
    },
    "kind": {
      "type": "string",
      "enum": [
        "CHAT_COMMAND",
        "SUPER_CHAT",
        "SUPER_STICKER",
        "GIFT",
        "MEMBERSHIP",
        "SYSTEM"
      ]
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "receivedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "actor": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "consented"
            },
            "displayName": {
              "type": "string",
              "pattern": "^[^\\p{Cc}\\p{Zl}\\p{Zp}]{1,100}$"
            },
            "channelRef": {
              "type": "string",
              "pattern": "^ref_[0-9a-f]{32}$"
            }
          },
          "required": [
            "kind",
            "displayName",
            "channelRef"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "command": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "enum": [
                "FEED",
                "PLAY",
                "PET",
                "VOTE_A",
                "VOTE_B",
                "VOTE_C"
              ]
            },
            "argument": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{1,32}$"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "name",
            "argument"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "payment": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "amountMicros": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            },
            "currency": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[A-Z]{3}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "tier": {
              "anyOf": [
                {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            },
            "jewels": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            },
            "comboCount": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            },
            "giftName": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9 _-]{1,64}$"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "amountMicros",
            "currency",
            "tier",
            "jewels",
            "comboCount",
            "giftName"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "sourceDataExpiresAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    }
  },
  "required": [
    "schemaVersion",
    "eventKey",
    "ingestSeq",
    "source",
    "broadcastId",
    "liveChatId",
    "kind",
    "occurredAt",
    "receivedAt",
    "actor",
    "command",
    "payment",
    "sourceDataExpiresAt"
  ],
  "additionalProperties": false
}
