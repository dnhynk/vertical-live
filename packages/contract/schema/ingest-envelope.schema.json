{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vl:contract:v1:ingest-envelope",
  "title": "IngestEnvelope",
  "description": "Append-only ingest inbox record for one API item (spec §7.3(1)(2)).",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "number",
          "const": 1
        },
        "sourceShape": {
          "type": "string",
          "enum": [
            "grpc",
            "rest",
            "simulator"
          ]
        },
        "source": {
          "type": "string",
          "enum": [
            "youtube",
            "simulator"
          ]
        },
        "broadcastId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]{1,128}$"
        },
        "liveChatId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]{1,128}$"
        },
        "receivedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
        },
        "messageId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]{1,128}$"
        },
        "validationStatus": {
          "type": "string",
          "const": "valid"
        },
        "kind": {
          "type": "string",
          "enum": [
            "CHAT_COMMAND",
            "SUPER_CHAT",
            "SUPER_STICKER",
            "GIFT",
            "MEMBERSHIP",
            "SYSTEM"
          ]
        },
        "occurredAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
        },
        "command": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "enum": [
                    "FEED",
                    "PLAY",
                    "PET",
                    "VOTE_A",
                    "VOTE_B",
                    "VOTE_C"
                  ]
                },
                "argument": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9_-]{1,32}$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "name",
                "argument"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "consentCommand": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "enum": [
                    "JOIN",
                    "LEAVE"
                  ]
                },
                "argument": {
                  "type": "null"
                }
              },
              "required": [
                "name",
                "argument"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "payment": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "amountMicros": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "currency": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^[A-Z]{3}$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "tier": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "jewels": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "comboCount": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "giftName": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9 _-]{1,64}$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "amountMicros",
                "currency",
                "tier",
                "jewels",
                "comboCount",
                "giftName"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "schemaVersion",
        "sourceShape",
        "source",
        "broadcastId",
        "liveChatId",
        "receivedAt",
        "messageId",
        "validationStatus",
        "kind",
        "occurredAt",
        "command",
        "payment"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "number",
          "const": 1
        },
        "sourceShape": {
          "type": "string",
          "enum": [
            "grpc",
            "rest",
            "simulator"
          ]
        },
        "source": {
          "type": "string",
          "enum": [
            "youtube",
            "simulator"
          ]
        },
        "broadcastId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]{1,128}$"
        },
        "liveChatId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]{1,128}$"
        },
        "receivedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
        },
        "messageId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.-]{1,128}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "validationStatus": {
          "type": "string",
          "enum": [
            "unsupported",
            "invalid"
          ]
        },
        "validationError": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "enum": [
                "MALFORMED_ITEM",
                "MISSING_MESSAGE_ID",
                "MALFORMED_MESSAGE_ID",
                "MISSING_SNIPPET",
                "MISSING_MESSAGE_TYPE",
                "UNSUPPORTED_MESSAGE_TYPE",
                "LIVE_CHAT_ID_MISMATCH",
                "MISSING_PUBLISHED_AT",
                "MALFORMED_PUBLISHED_AT",
                "MISSING_EVENT_DETAILS",
                "MALFORMED_AMOUNT",
                "MALFORMED_TIER",
                "MALFORMED_JEWELS",
                "MALFORMED_COMBO_COUNT"
              ]
            },
            "field": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_]+(\\.[A-Za-z0-9_]+)*$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "sourceMessageType": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[A-Za-z_]{1,64}$"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "code",
            "field",
            "sourceMessageType"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schemaVersion",
        "sourceShape",
        "source",
        "broadcastId",
        "liveChatId",
        "receivedAt",
        "messageId",
        "validationStatus",
        "validationError"
      ],
      "additionalProperties": false
    }
  ]
}
