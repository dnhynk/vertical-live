{
  "name": "@vl/contract",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./fixtures": {
      "types": "./dist/fixtures/load.d.ts",
      "default": "./dist/fixtures/load.js"
    },
    "./schema/*": "./schema/*"
  },
  "scripts": {
    "build": "tsc --build && node scripts/generate-schema.mjs --check",
    "schema:generate": "tsc --build && node scripts/generate-schema.mjs"
  },
  "dependencies": {
    "zod": "4.4.3"
  }
}
