# Python
__pycache__/
*.pyc

# Local data / secrets — only the repository-root database directory. A bare
# `data/` also hid source directories such as `apps/server/src/input/data`
# (found in T6), so the rule is anchored to the root.
/data/
*.db
*.db-wal
*.db-shm
.env
.env.*
!.env.example
# OAuth client secrets downloaded from Google Cloud console (spec §10.2)
client_secret*.json
config/*.local.json
